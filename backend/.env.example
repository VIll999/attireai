# App
DEBUG=false

# Database (MySQL)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/attireai

# Firebase
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=attireai

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","https://attireai.vercel.app"]

# AI Recommendation Engine
# Options: gemini, openai, mock
AI_PROVIDER=mock

# Required only if AI_PROVIDER=gemini
GOOGLE_API_KEY=your-google-api-key

# Stripe (Sprint 3)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
VIP_MONTHLY_PRICE_USD=9.99

# Free tier limits
FREE_DAILY_RECOMMENDATIONS=5
VIP_FREE_TRIAL_USES=1

# Admin (comma-separated emails)
ADMIN_EMAILS=